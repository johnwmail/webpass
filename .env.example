# WebPass Environment Configuration

# JWT secret key for signing tokens (required in production)
# Generate with: openssl rand -hex 32
# Minimum length: 32 bytes. Example/placeholder values are rejected at startup.
#
# Note: If not set, a random key is generated on each startup.
# This is fine for single-instance deployments with short sessions, but
# sessions are invalidated on every restart. Set a fixed value for:
#   - Multi-instance deployments (load balancer with multiple pods)
#   - Long session durations (don't want restarts to invalidate sessions)
#   - Production environments requiring predictable behavior
JWT_SECRET=your-random-32-byte-hex-string-here

# Path to SQLite database file (optional)
# Docker: DB_PATH=/data/db/db.sqlite3
# Local dev: DB_PATH=./data/db/db.sqlite3
DB_PATH=./data/db/db.sqlite3

# Directory containing frontend static files (optional)
# The SPA is embedded into the binary by default. Set this to serve assets from
# disk instead (local development / custom deployments). If unset or the
# directory does not exist, the embedded assets are used.
# Default: frontend/dist (only honored when the directory exists)
STATIC_DIR=frontend/dist

# Disable frontend serving (optional)
# Set to "1" or "true" to disable even if STATIC_DIR exists
# Default: false (frontend enabled)
# DISABLE_FRONTEND=1

# HTTP listen port (optional)
# Default: 8080
# PORT=8080

# Git repository root for git sync feature (optional)
# Default: /data/git-repos (use ./git-repos for local development)
# Docker: GIT_REPO_ROOT=/data/git-repos
# Local dev: GIT_REPO_ROOT=./git-repos
GIT_REPO_ROOT=./git-repos

# CORS allowed origins (optional)
# Comma-separated list of allowed origins.
# If not set, cross-origin requests are DENIED (same-origin only). This is the
# secure default: the SPA is normally served by this same server, and the Vite
# dev server proxies /api so no CORS entry is needed for local development.
# CORS_ORIGINS=https://webpass.example.com,https://webpass.pages.dev

# Trusted reverse proxies (optional)
# Comma-separated IPs or CIDRs. X-Forwarded-For / X-Real-IP are only honored
# when the direct peer matches this list (needed for correct rate limiting).
# TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10

# Maximum request body size in bytes (optional)
# Default: 8388608 (8 MiB). Valid range: 1048576 - 67108864.
# MAX_REQUEST_BODY_BYTES=8388608

# Git remote safety (optional)
# By default, git sync rejects file:// URLs and hosts that resolve to
# loopback/private/link-local addresses (SSRF protection).
# GIT_ALLOW_LOCAL_REPOS=true          # allow file:// remotes (local dev/tests)
# GIT_ALLOW_PRIVATE_NETWORKS=true     # allow LAN/private self-hosted remotes
# GIT_ALLOW_INSECURE_HTTP=true        # allow plain http:// remotes
# GIT_ALLOWED_HOSTS=github.com,gitlab.com   # optional host allowlist

# Require HTTPS (optional)
# When true, API requests over plain HTTP are rejected and browser navigation
# is redirected to HTTPS. Localhost/127.0.0.1 remain exempt for development.
# REQUIRE_HTTPS=false

# Hard limit (optional)
# Default: 30, Valid range: 5-480 (5 minutes to 8 hours)
# Maximum time a session can last from login (regardless of activity)
# SESSION_HARDLIMIT_MINUTES=30

# Soft limit (optional)
# Default: 5, Valid range: 1-60 (1 minute to 1 hour)
# Detects browser close: session expires if no activity for this duration
# SESSION_SOFTLIMIT_MINUTES=5

# ============================================
# Cookie-based Authentication (httpOnly)
# ============================================
# Enable httpOnly cookie authentication (default: false)
# When enabled, JWT tokens are stored in httpOnly cookies instead of localStorage
# This provides better XSS protection but requires same-origin or properly configured CORS
# 
# For PRODUCTION (recommended): Set to "true" for enhanced security
# For LOCAL DEVELOPMENT: Keep "false" (uses Bearer token in Authorization header)
#   - Existing E2E tests require COOKIE_AUTH_ENABLED=false (default)
#   - Cookie auth tests require COOKIE_AUTH_ENABLED=true
# COOKIE_AUTH_ENABLED=false

# Cookie Secure flag (default: false)
# Set to "true" when using HTTPS in production
# Leave unset or "false" for local HTTP development
# COOKIE_SECURE=false

# Cookie Domain (optional)
# Only set if you need to share cookies across subdomains
# Example: COOKIE_DOMAIN=.example.com
# Leave unset for default (current domain only)
# COOKIE_DOMAIN=

# ============================================
# Rate Limiting (Authentication Protection)
# ============================================
# Maximum authentication attempts allowed per window (optional)
# Default: 5 attempts
# Applies to: login, 2FA, and registration endpoints
# RATE_LIMIT_ATTEMPTS=5

# Rate limit window duration in minutes (optional)
# Default: 15 minutes
# Sliding window algorithm - no "reset" at boundaries
# RATE_LIMIT_WINDOW_MINUTES=15

# ============================================
# Registration Protection Mode (TOTP-based)
# ============================================
# Enable user registration (default: false)
# Set to "true" to allow new user registration
# REGISTRATION_ENABLED=false

# TOTP secret for protected registration mode (optional)
# Generate with: openssl rand -base64 32 | tr -d '=' | tr '+/' '-_'
# If set and REGISTRATION_ENABLED=true, users must enter 6-digit TOTP code to register
# Leave empty for open registration (no code required)
# REGISTRATION_TOTP_SECRET=your-base32-secret-here

# TOTP code validity period in seconds (optional)
# Default: 3600 (1 hour), Valid range: 15-86400
# REGISTRATION_TOTP_PERIOD=3600

# Hash algorithm for TOTP (optional)
# Options: SHA1, SHA256, SHA512
# Default: SHA1
# REGISTRATION_TOTP_ALGO=SHA1

# Path to registration code file (optional)
# Current valid code is written here (rotates every configured period).
# The code itself is not logged at INFO; administrators read it from this file.
# Default: /data/registration_code.txt (Docker) or ./data/registration_code.txt (local)
# REGISTRATION_CODE_FILE=./data/registration_code.txt

# ============================================
# Data-at-rest encryption
# ============================================
# Key used to encrypt secrets stored in the database (TOTP secrets).
# Optional: if unset, a 32-byte key is generated next to DB_PATH as
# `data_encryption.key` (mode 0600) on first start. Back this file up together
# with the database; without it, TOTP secrets cannot be decrypted.
# Generate with: openssl rand -hex 32
# DATA_ENCRYPTION_KEY=

# ============================================
# Bcrypt Password Hashing
# ============================================
# Bcrypt cost factor for password hashing (optional)
# Default: 12, Valid range: 10-15
# Higher values are more resistant to brute-force attacks but slower.
# Each increment doubles the hashing time (12 = 4x stronger than default 10).
# OWASP recommends minimum cost factor 12 for bcrypt.
# BCRYPT_COST=12

# ============================================
# E2E Test Configuration
# ============================================
# Optional Git remote for E2E tests.
# By default the test script and CI use a local file:// bare repository, so
# no external server or PAT is needed. Only set these to test a real remote.
#
# WEBPASS_REPO_URL=https://gitea.example.com/user/password-store.git
# WEBPASS_REPO_PAT=your-personal-access-token-here

# ============================================
# WebAuthn / Passkeys (optional)
# ============================================
# Enable passkeys (Face ID / Touch ID / security keys) as a second factor.
# RP_ID must be the site's registrable domain, without scheme or port.
# RP_ORIGINS must match the exact public origin(s), comma-separated.
# Leave RP_ID unset to disable passkeys.
# WEBAUTHN_RP_ID=webpass.example.com
# WEBAUTHN_RP_NAME=WebPass
# WEBAUTHN_RP_ORIGINS=https://webpass.example.com
