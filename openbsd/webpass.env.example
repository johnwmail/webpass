# WebPass environment file for the OpenBSD rc.d service.
#
# Install as /etc/webpass.env, owned by root:_webpass with mode 0640, because
# it contains the JWT signing secret. Values containing spaces must be quoted.

# Required. JWT signing key. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-hex

# Runtime paths. Must be writable by _webpass.
DB_PATH=/var/webpass/db.sqlite3
GIT_REPO_ROOT=/var/webpass/git-repos
REGISTRATION_CODE_FILE=/var/webpass/registration_code.txt

# HTTP listener.
PORT=8080

# Comma-separated allowed browser origins. Leave unset when the SPA is served
# by this same process (the embedded frontend) and accessed same-origin.
# CORS_ORIGINS=https://webpass.example.com

# httpOnly cookie auth. Enable for production behind HTTPS. COOKIE_SECURE
# requires HTTPS or the browser will drop the cookie.
COOKIE_AUTH_ENABLED=true
COOKIE_SECURE=true

# Registration (optional).
# REGISTRATION_ENABLED=true
# REGISTRATION_TOTP_SECRET=your-base32-secret-here
# REGISTRATION_TOTP_PERIOD=3600
# REGISTRATION_TOTP_ALGO=SHA1

# Session limits (optional).
# SESSION_HARDLIMIT_MINUTES=30
# SESSION_SOFTLIMIT_MINUTES=5

# Password hashing cost (optional, default 12, range 10-15).
# BCRYPT_COST=12

# Rate limiting (optional, defaults: 5 attempts / 15 minutes).
# RATE_LIMIT_ATTEMPTS=5
# RATE_LIMIT_WINDOW_MINUTES=15
