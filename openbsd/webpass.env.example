# WebPass environment file for the OpenBSD rc.d service.
#
# Install as /etc/webpass.env, owned by root:_webpass with mode 0640, because
# it contains the JWT signing secret. Values containing spaces must be quoted.

# Required. JWT signing key. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-hex

# Runtime paths. Must be writable by _webpass.
DB_PATH=/var/webpass/db.sqlite3
GIT_REPO_ROOT=/var/webpass/git-repos
REGISTRATION_CODE_FILE=/var/webpass/registration_code.txt

# HTTP listener.
PORT=8080

# Comma-separated allowed browser origins. Leave unset when the SPA is served
# by this same process (the embedded frontend) and accessed same-origin.
# CORS_ORIGINS=https://webpass.example.com

# httpOnly cookie auth. Enable for production behind HTTPS. Session and CSRF
# cookies are always marked Secure, so HTTPS is required (localhost is exempt).
COOKIE_AUTH_ENABLED=true

# Registration (optional).
# REGISTRATION_ENABLED=true
# REGISTRATION_TOTP_SECRET=your-base32-secret-here
# REGISTRATION_TOTP_PERIOD=3600
# REGISTRATION_TOTP_ALGO=SHA1

# Session limits (optional).
# SESSION_HARDLIMIT_MINUTES=30
# SESSION_SOFTLIMIT_MINUTES=5

# Browser PGP key auto-lock (seconds, default 30). 0 disables caching;
# otherwise the range is 5-3600.
# PGP_KEY_TIMEOUT_SECONDS=30

# WebAuthn / Passkeys (optional).
# Enable passkeys (Face ID / Touch ID / security keys) as a second factor.
# RP_ID must be the site's registrable domain, without scheme or port; passkeys
# are disabled when it is unset. RP_ORIGINS must list the exact public
# origin(s), comma-separated (defaults to https://<RP_ID>).
# Browsers only offer passkeys on a secure context: use HTTPS on a real domain
# (browsers treat localhost as secure for testing only).
# WEBAUTHN_RP_ID=webpass.example.com
# WEBAUTHN_RP_NAME=WebPass
# WEBAUTHN_RP_ORIGINS=https://webpass.example.com

# Password hashing cost (optional, default 12, range 10-15).
# BCRYPT_COST=12

# Rate limiting (optional, defaults: 5 attempts / 15 minutes).
# RATE_LIMIT_ATTEMPTS=5
# RATE_LIMIT_WINDOW_MINUTES=15

# OpenBSD sandbox (pledge/unveil) is enabled automatically.
#
# Override the pledge promise set (default shown). Invalid values make startup
# fail closed with EINVAL.
# OPENBSD_PLEDGE_PROMISES="stdio rpath wpath cpath inet dns unix flock fattr"
#
# Extra unveil paths, comma-separated as path[:flags]. Flags are a subset of
# r/w/c (default r); w/c also unveil the parent directory.
# OPENBSD_UNVEIL_EXTRA_PATHS="/etc/custom-certs:r,/var/cache/webpass:rwc"
#
# Set to 1 only for debugging a deployment; it removes the process sandbox.
# DISABLE_SANDBOX=1
