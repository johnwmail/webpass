{
  "name": "webpass-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "echo 'No linter configured'"
  },
  "dependencies": {
    "fflate": "^0.8.3",
"lucide-preact": "^1.67.0",
    "openpgp": "^6.3.2",
    "otpauth": "^9.5.2",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/tar-stream": "^3.1.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tar-stream": "^3.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
